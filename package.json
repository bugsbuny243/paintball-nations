{
  "name": "paintball-nations",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "world:migrate": "tsx apps/game-backend/src/migrate.ts",
    "world:serve": "tsx apps/game-backend/src/server.ts",
    "world:check": "tsc --noEmit",
    "world:test": "tsx --test tests/world-core.test.ts",
    "world:verify": "npm run world:check && npm run world:test && npm run pilot:test",
    "online:serve": "tsx apps/game-backend/src/online-server.ts",
    "online:build": "esbuild maps/macka-online-client.js --bundle --minify --format=iife --platform=browser --target=es2020 --outfile=maps/macka-online.bundle.js",
    "online:test": "tsx --test --test-concurrency=1 tests/online-macka.test.ts tests/pilot-match.test.ts",
    "online:verify": "npm run world:check && npm run online:build && npm run online:test",
    "pilot:test": "tsx --test tests/pilot-profile.test.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "colyseus": "0.18.10",
    "@colyseus/sdk": "0.18.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.12",
    "@colyseus/testing": "0.18.6"
  },
  "overrides": {
    "@colyseus/core": "0.18.28"
  }
}
