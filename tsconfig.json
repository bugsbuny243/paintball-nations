{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "apps/game-backend/src/**/*.ts",
    "packages/protocol/src/**/*.ts",
    "tests/world-core.test.ts",
    "tests/online-macka.test.ts",
    "tests/pilot-profile.test.ts",
    "tests/pilot-match.test.ts",
    "tests/frontline-settlement.test.ts",
    "tests/frontline-recovery.test.ts",
    "tests/frontline-room.test.ts"
  ]
}
